NEBIUS_API_KEY=

# Nebius Model IDs (Default: nvidia/llama-3.1-nemotron-70b-instruct)
NEBIUS_MODEL_REASONING=nvidia/llama-3.1-nemotron-70b-instruct
NEBIUS_MODEL_ROUTER=nvidia/llama-3.1-nemotron-70b-instruct

# Tavily Search API Key (Optional, enables live search for Deals, Travel & Explore)
# Eligible for the $3,000 "Best Use of Tavily" sponsor award
# Get yours from https://tavily.com
TAVILY_API_KEY=
