# Optional host defaults. Judges/users can paste Nebius + Tavily in the in-app
# API Credentials modal instead — no .env required for the happy path.
# Get Nebius from https://tokenfactory.nebius.com
NEBIUS_API_KEY=

# Nemotron 3 tier models (Orbit Core uses Nano to pick planets + response tier)
# Nano: decision classifier + fast everyday answers
NEBIUS_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Super: everyday synthesis (us-central1 host by default)
NEBIUS_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# Ultra: serious multi-constraint reasoning
NEBIUS_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Legacy aliases (optional): ROUTER -> Nano decision; REASONING -> Ultra only if not Nano
NEBIUS_MODEL_ROUTER=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_REASONING=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Optional host overrides (Super/Ultra default to us-central1)
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NEBIUS_BASE_URL_SUPER=https://api.tokenfactory.us-central1.nebius.com/v1
# NEBIUS_BASE_URL_ULTRA=https://api.tokenfactory.us-central1.nebius.com/v1

# Optional host default for Deals, Travel & Explore (+ Best Use of Tavily).
# Users can also paste tvly-... in the in-app credentials modal.
# Get yours from https://tavily.com
TAVILY_API_KEY=

# Public app URL used for OAuth redirect URIs (no trailing slash)
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app
# Required only if you enable Google / Notion / Slack connectors (one-time host setup).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to encrypt the connector session cookie (use a long random string)
CONNECTOR_SECRET=

# --- Connector OAuth (one-time host config; per-user Connect still happens in UI) ---
# Client ID/secret cannot be fully registered in-browser: redirect URIs must match
# the deployed origin. Core chat, Shared Brain, and Tavily do not need these.

# Google OAuth (Calendar + Gmail + Drive)
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/connectors/google/callback
# Enable Google Calendar API, Gmail API, and Google Drive API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notion public integration OAuth
# https://developers.notion.com/docs/authorization
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/connectors/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Slack app OAuth (user token scopes: search:read, users:read)
# Redirect URI: {NEXT_PUBLIC_APP_URL}/api/connectors/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
