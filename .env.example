# --- Account auth (required to use the app) ---
# Firebase Auth (email/password + Google) + Firestore Shared Brain profiles.
# Console: https://console.firebase.google.com → create project → enable Auth + Firestore.
# Copy web app config from Project settings → Your apps.
# Full setup: see README § Account auth / docs in the Orbit project store.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google sign-in: enable the Google provider under Firebase Authentication → Sign-in method.
# Add authorized domains: localhost, orbit-nebius-hackathon.vercel.app
# (Firebase manages the OAuth client; optional: reuse/customize in Google Cloud Console.)

# Optional host defaults. Judges/users can paste Nebius + Tavily in the in-app
# API Credentials modal instead — no .env required for inference.
# Get Nebius from https://tokenfactory.nebius.com
NEBIUS_API_KEY=

# Nemotron 3 tier models (Orbit Core uses Nano to pick planets + response tier)
# Nano: decision classifier + fast everyday answers
NEBIUS_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Super: everyday synthesis (us-central1 host by default)
NEBIUS_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# Ultra: serious multi-constraint reasoning
NEBIUS_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Legacy aliases (optional): ROUTER -> Nano decision; REASONING -> Ultra only if not Nano
NEBIUS_MODEL_ROUTER=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_REASONING=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Optional host overrides (Super/Ultra default to us-central1)
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NEBIUS_BASE_URL_SUPER=https://api.tokenfactory.us-central1.nebius.com/v1
# NEBIUS_BASE_URL_ULTRA=https://api.tokenfactory.us-central1.nebius.com/v1

# Optional host default for Deals, Travel & Explore (+ Best Use of Tavily).
# Users can also paste tvly-... in the in-app credentials modal.
# Get yours from https://tavily.com
TAVILY_API_KEY=

# --- Sovereign Connectors (marketplace Connect → provider auth → connected) ---
# Prefer setting these ONCE on the Vercel submit deploy so judges only click Connect.
# Empty host / self-host can use dock Advanced (encrypted orbit_oauth_apps cookie).

# Public app URL used for OAuth redirect URIs (no trailing slash)
# Local: http://localhost:3000
# Production: https://orbit-nebius-hackathon.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to encrypt connector session + OAuth app stash cookies
CONNECTOR_SECRET=

# Google OAuth (Calendar + Gmail + Drive)
# https://console.cloud.google.com/apis/credentials
# Redirect: {NEXT_PUBLIC_APP_URL}/api/connectors/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notion public integration OAuth
# https://developers.notion.com/docs/authorization
# Redirect: {NEXT_PUBLIC_APP_URL}/api/connectors/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Slack app OAuth (user token scopes: search:read, users:read)
# Redirect: {NEXT_PUBLIC_APP_URL}/api/connectors/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
